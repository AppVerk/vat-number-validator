{
    "name": "app-verk/vat-number-validator",
    "description": "PHP library to validate VAT numbers",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Antal Áron",
            "email": "antalaron@antalaron.hu"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/validator": "^5.4|^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Antalaron\\Component\\VatNumberValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Antalaron\\Component\\VatNumberValidator\\Tests\\": "tests/Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
